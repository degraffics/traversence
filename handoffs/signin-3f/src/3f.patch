+final class StaffMailHelp
+{
+    public const PER_LOGIN_DAY = 3;      // requests (and updates) for one staff login in 24 hours
+    public const PER_ADDRESS_DAY = 6;    // from one network address in 24 hours
+    public const SESSION_WAIT = 120;     // seconds between two sends from one browser
+
+    private static bool $ready = false;
+
+    public static function ensure(PDO $pdo): void
+    {
+        if (self::$ready) return;
+        $pdo->exec('CREATE TABLE IF NOT EXISTS ' . Database::t('staff_mail_requests') . ' (
+            id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+            staff_account_id INT UNSIGNED NOT NULL,
+            name VARCHAR(120) NOT NULL DEFAULT \'\',
+            contact VARCHAR(190) NOT NULL DEFAULT \'\',
+            ip_hash CHAR(64) NOT NULL DEFAULT \'\',
+            device VARCHAR(120) NOT NULL DEFAULT \'\',
+            tz VARCHAR(64) NOT NULL DEFAULT \'\',
+            sends INT UNSIGNED NOT NULL DEFAULT 1,
+            status VARCHAR(12) NOT NULL DEFAULT \'open\',
+            outcome VARCHAR(300) NOT NULL DEFAULT \'\',
+            done_by INT UNSIGNED NULL,
+            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+            updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+            done_at DATETIME NULL,
+            KEY by_login (staff_account_id, status),
+            KEY by_ip (ip_hash, updated_at)
+        ) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci');
+        self::$ready = true;
+    }
+
+    /** A phone (7+ digits) or an email address; '' when it's neither. */
