+        return 'Sent to the owners. One of them will contact you at ' . $c . ' to check it\'s you, then give you a new way in. Nothing changes on your login until then.';
+    }
+
+    public static function get(PDO $pdo, int $id): ?array
+    {
+        self::ensure($pdo);
+        $st = $pdo->prepare('SELECT * FROM ' . Database::t('staff_mail_requests') . ' WHERE id = ?'); $st->execute([$id]);
