index 71c222f..331e4b0 100644
--- a/app/lib/ControlAlarms.php
+++ b/app/lib/ControlAlarms.php
@@ -264,6 +264,12 @@ final class ControlAlarms
             // a need with no source working (a pre-flight need line): the tasks that call its services wait, in every workflow
             // it names, never the whole of the first one (the workflow audit, 2026-11-21; decisions/0175 §3: "a trip stops only
             // what it holds"). A need whose services no task calls keeps the old pause on its workflow.
+            // a crawler task that failed (CrawlService's task:failed:<t>): only that task waits; its workflow's other tasks carry
+            // on, as its own words say (decisions/0175 §3: "a trip stops only what it holds"; case #51, 2026-11-21)
+            if (preg_match('/^task:failed:([a-z0-9_]+)$/', $key, $tm)) {
+                if (Automation::taskOff($pdo, $tm[1]) === null) $pause('task', $tm[1], $tm[1] . ' (' . substr($proc, 3) . '\'s other tasks carry on)');
+                return $out;
+            }
             if (preg_match('/^pf:nd:([a-z_]+)$/', $key, $nm)) {
                 require_once __DIR__ . '/Preflight.php'; require_once __DIR__ . '/OutsideServices.php'; require_once __DIR__ . '/ControlRegister.php';
                 $nd = Preflight::NEEDS[$nm[1]] ?? null; $tw = ControlRegister::taskWorkflows($pdo); $tasks = [];
diff --git a/app/lib/crawler/CrawlService.php b/app/lib/crawler/CrawlService.php
