index 00000000..5d2028ab
--- /dev/null
+++ b/tools/control-board-tests/task-failures.php
@@ -0,0 +1,48 @@
+<?php
+// Case #51 (2026-11-21: W1's overture_bulk failed on a TimeoutError, and the trip paused all of W1). A crawler task's
+// trip pauses only that task, its workflow's other tasks carrying on, as the alarm's own words say (decisions/0175 §3: "a trip
+// stops only what it holds"). Its tries keep the hour (0171's note of 2026-11-20, Jason: "Keep the hour"). Our own site slow to
+// answer (the worker's SiteSlow) is a warning that clears itself, never a crash (0171's note, Jason 2026-11-19: slow is never a
+// trip). Run: mariadb < ../release-b-tests/start-schema.sql && php task-failures.php <root>/app
+declare(strict_types=1);
+$app = $argv[1]; if (is_file($app . '/admin/Access.php')) require_once $app . '/admin/Access.php';
+require_once $app . '/lib/Auth.php'; require_once $app . '/lib/Database.php'; $pdo = Database::connection();
+$pass = 0; $fail = 0;
+$t = function (string $n, bool $ok, $got = null) use (&$pass, &$fail) { if ($ok) { $pass++; echo "  ok  $n\n"; } else { $fail++; echo "FAIL  $n" . ($got !== null ? ' — ' . mb_substr(is_string($got) ? $got : json_encode($got, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), 0, 600) : '') . "\n"; } };
+require_once $app . '/lib/ControlAlarms.php'; require_once $app . '/lib/Automation.php';
+$pdo->exec('DROP TABLE IF EXISTS control_alarms'); ControlAlarms::ensure($pdo);
+$pdo->exec("INSERT IGNORE INTO crawl_capture_tasks (task, wf, enabled) VALUES ('overture_bulk', 'W1', 1), ('coverage', 'W1', 1)");
+$pdo->exec('DROP TABLE IF EXISTS system_pauses');
+$pdo->exec("CREATE TABLE system_pauses (id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, kind VARCHAR(10) NOT NULL, ref VARCHAR(60) NOT NULL, alarm_id INT UNSIGNED NULL, why VARCHAR(255) NOT NULL DEFAULT '', at DATETIME NOT NULL, cleared_at DATETIME NULL, cleared_how VARCHAR(255) NULL)");
+$raise = fn () => ControlAlarms::raise($pdo, 'task:failed:overture_bulk', 'wf:W1', 'trip', 'crash', 'W1: its task overture_bulk failed (run #1290)', 'Its work goes back and the next run tries it again; the workflow\'s other tasks carry on.', 'Read its why.', 'TimeoutError', [], true);
+$row = fn () => $pdo->query("SELECT * FROM control_alarms WHERE akey = 'task:failed:overture_bulk'")->fetch(PDO::FETCH_ASSOC);
+$paused = fn () => $pdo->query("SELECT CONCAT(kind, ':', ref) FROM system_pauses WHERE cleared_at IS NULL")->fetchAll(PDO::FETCH_COLUMN);
+[$max, $mins] = ControlAlarms::limits($pdo, 'crash');
+
+$raise(); $a = $row();
+$t('its first failure is a warning: the system trying again by itself (1 of ' . $max . ' tries, until …)', $a['level'] === 'warning' && str_contains((string) $a['means'], '(1 of ' . $max . ' tries, until '), $a['means']);
+$t('…nothing is paused', $paused() === []);
+// the hour runs out with no fix (a nightly task: its next run is a day later): the watch makes it a trip, as Jason chose
+$pdo->exec("UPDATE control_alarms SET first_at = UTC_TIMESTAMP() - INTERVAL 2 HOUR, last_at = UTC_TIMESTAMP() - INTERVAL 2 HOUR WHERE akey = 'task:failed:overture_bulk'");
+ControlAlarms::expireTries($pdo); Automation::forget(); $a = $row();
+$t('its hour gone with no fix: a trip (0171\'s note: Keep the hour)', $a['level'] === 'trip' && !empty($a['tripped_at']), $a);
+$p = $paused();
+$t('…which pauses only that task, never W1 (its other tasks carry on)', in_array('task:overture_bulk', $p, true) && !in_array('wf:W1', $p, true), $p);
+$t('…and Check and start again has it to start again', str_contains((string) $a['stopped'], 'task:overture_bulk'), $a['stopped']);
+$t('…its words say what it held', str_contains((string) $a['stopped'], "overture_bulk (W1's other tasks carry on)"), $a['stopped']);
+$t('…W1 itself is not paused, its other tasks still run', Automation::taskOff($pdo, 'coverage') === null && Automation::taskOff($pdo, 'overture_bulk') !== null, [Automation::taskOff($pdo, 'coverage'), Automation::taskOff($pdo, 'overture_bulk')]);
+ControlAlarms::clear($pdo, 'task:failed:overture_bulk', 'It did its work in run #1291.'); Automation::forget();
+$t('it did its work: the trip closes and the task runs again', $paused() === [] && Automation::taskOff($pdo, 'overture_bulk') === null, $paused());
+
+// any other alarm keeps its clock (0171 §5's limits)
+ControlAlarms::raise($pdo, 'ep:x:5xx', 'site:x', 'trip', 'crash', 'x failed', '', '', '', [], true);
+$o = $pdo->query("SELECT means FROM control_alarms WHERE akey = 'ep:x:5xx'")->fetchColumn();
+$t('any other crash: the same clock\'s words', str_contains((string) $o, ' tries, until '), $o);
+
+// our own site slow: a warning that clears itself
+$cs = (string) file_get_contents($app . '/lib/crawler/CrawlService.php');
+$t('a task that stopped because our site was slow (SiteSlow) raises task:slow, a warning, never task:failed', str_contains($cs, "if (\$o === 'failed' && str_starts_with((string) \$tw, 'SiteSlow(')) {") && str_contains($cs, "'task:slow:' . \$t, 'wf:' . \$tasks[\$t]['wf'], 'warning', 'slow'"));
+$t('…and it clears when the task does its work', str_contains($cs, "if (\$o === 'done') ControlAlarms::clear(\$pdo, 'task:slow:' . \$t,"));
+ControlAlarms::raise($pdo, 'task:slow:overture_bulk', 'wf:W1', 'trip', 'slow', 'W1: our site was slow', '', '', '', []);
+$t('…slow is never a trip, even asked for one', $pdo->query("SELECT level FROM control_alarms WHERE akey = 'task:slow:overture_bulk'")->fetchColumn() === 'warning');
+echo "\n$pass passed, $fail failed\n"; exit($fail ? 1 : 0);
