+"""2.16.2 (case #51, 2026-11-21): our own site slow is SiteSlow, never a crash: no answer in time, or a 5xx from it, raises
+SiteSlow (a RuntimeError keeping "site <path> said 5xx: …" for geofabrik_send); a 4xx stays an ordinary error. Overture and
+Foursquare send OPEN_LOAD_BATCH rows a batch, and one our site was slow for is sent once more. The task's why names
+SiteSlow, so the site counts it as slow. Run: python3 tests/test_site_slow.py"""
+import io, os, socket, sys, urllib.error
+os.environ.setdefault("TRAVERSENCE_URL", "http://127.0.0.1:1")
+os.environ.setdefault("CRAWLER_API_TOKEN", "t")
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import crawler  # noqa: E402
+
+fails = 0
+def check(name, ok):
+    global fails
+    print(("  ok  " if ok else "FAIL  ") + name)
+    fails += 0 if ok else 1
+
+def raising(exc):
+    def f(path, data, timeout):
+        raise exc
+    return f
+
+def err(code):
+    return urllib.error.HTTPError("http://x", code, "x", {}, io.BytesIO(b"<html>busy</html>"))
+
+for name, exc in [("a timeout", TimeoutError("timed out")), ("a socket timeout", socket.timeout("timed out")), ("a URLError around a timeout", urllib.error.URLError(TimeoutError("timed out")))]:
+    crawler._site_request = raising(exc)
+    try:
+        crawler.site_call("/api/crawl/loads.php", {"x": 1}, timeout=120); got = None
+    except Exception as e:
+        got = e
+    check(f"{name} from our site is SiteSlow, saying how long it waited", isinstance(got, crawler.SiteSlow) and "no answer in 120 s" in str(got))
+crawler._site_request = raising(err(503))
+try:
+    crawler.site_call("/api/crawl/loads.php", {"x": 1}); got = None
+except Exception as e:
+    got = e
+check("a 503 from our site is SiteSlow, its words kept for geofabrik_send", isinstance(got, crawler.SiteSlow) and isinstance(got, RuntimeError) and " said 503: " in str(got))
+crawler._site_request = raising(err(403))
+try:
+    crawler.site_call("/api/crawl/loads.php", {"x": 1}); got = None
+except Exception as e:
+    got = e
+check("a 403 stays an ordinary error (not slow)", isinstance(got, RuntimeError) and not isinstance(got, crawler.SiteSlow))
+
+# a slow batch is sent once more
+calls = []
+def flaky(path, payload=None, timeout=60):
+    calls.append(payload)
+    if len(calls) == 1:
+        raise crawler.SiteSlow("site /api/crawl/loads.php: no answer in 120 s")
+    return {"ok": True}
+crawler.site_call, real = flaky, crawler.site_call
+crawler.OPEN_LOAD_WAIT = 0
+check("a batch our site was slow for is sent once more, the same batch", crawler.open_load_send({"rows": [1, 2]}) == {"ok": True} and len(calls) == 2 and calls[0] == calls[1])
+calls.clear()
+def slow(path, payload=None, timeout=60):
+    calls.append(payload); raise crawler.SiteSlow("site /api/crawl/loads.php: no answer in 120 s")
+crawler.site_call = slow
+try:
+    crawler.open_load_send({"rows": [1]}); got = None
+except Exception as e:
+    got = e
+check("…still slow the second time: SiteSlow goes up (the task's why names it)", isinstance(got, crawler.SiteSlow) and len(calls) == 2)
+crawler.site_call = real
+check("batches are smaller than before (500)", crawler.OPEN_LOAD_BATCH < 500 and "rows[i:i + OPEN_LOAD_BATCH]" in open(crawler.__file__).read())
+
+# the task's outcome and why
+item = {"task": "overture_bulk", "allotted": 60, "counts": {}}
+def task(deadline):
+    raise crawler.SiteSlow("site /api/crawl/loads.php: no answer in 120 s")
+crawler.HANDLERS["slowtask"] = (task, None, lambda: "")
+crawler.work_task({"task": "slowtask", "seconds": 60}, item, 60)
+check("the task reports its why starting SiteSlow( (the site counts it slow, never a crash)", item.get("outcome") == "failed" and item.get("why", "").startswith("SiteSlow("))
+check("the worker's version says 2.16.2", crawler.WORKER_V == "2.16.2")
+print("all passed" if not fails else f"{fails} failed")
+sys.exit(1 if fails else 0)
