diff --git a/tools/control-board-tests/task-failures.php b/tools/control-board-tests/task-failures.php
new file mode 100644
index 00000000..6c846df0
--- /dev/null
+++ b/tools/control-board-tests/task-failures.php
@@ -0,0 +1,112 @@
+<?php
+// The urgent W1 release (case #51, 2026-11-21; Jason chose "Lift now + urgent fix"): replayed through CrawlService::report as
+// the worker sends it. A failed task's trip pauses only that task, never its workflow (model 1.2; decisions/0175 §3). Our own
+// endpoint's timeout or 5xx where the worker sends is recorded against the endpoint, never a task failure against its source:
+// a timeout is slow, a warning, nothing paused (0171's note of 2026-11-19); a 5xx trips the endpoint and holds nothing, so its
+// next good answer can clear it. A run stopped only by our endpoint isn't the crawler failing. A paused task's trip closes:
+// a person's lift, then its next run. Keep the hour is untouched.
+// Run: mariadb < ../release-b-tests/start-schema.sql && php task-failures.php <root>/app
+declare(strict_types=1);
+$app = $argv[1]; if (is_file($app . '/admin/Access.php')) require_once $app . '/admin/Access.php';
+require_once $app . '/lib/Auth.php'; require_once $app . '/lib/Database.php'; $pdo = Database::connection();
+$pass = 0; $fail = 0;
+$t = function (string $n, bool $ok, $got = null) use (&$pass, &$fail) { if ($ok) { $pass++; echo "  ok  $n\n"; } else { $fail++; echo "FAIL  $n" . ($got !== null ? ' — ' . mb_substr(is_string($got) ? $got : json_encode($got, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), 0, 700) : '') . "\n"; } };
+require_once $app . '/lib/ControlAlarms.php'; require_once $app . '/lib/Automation.php'; require_once $app . '/lib/crawler/CrawlService.php';
+$pdo->exec('DROP TABLE IF EXISTS control_alarms'); ControlAlarms::ensure($pdo);
+$pdo->exec('DROP TABLE IF EXISTS system_pauses');
+$pdo->exec("CREATE TABLE system_pauses (id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, kind VARCHAR(10) NOT NULL, ref VARCHAR(60) NOT NULL, alarm_id INT UNSIGNED NULL, why VARCHAR(255) NOT NULL DEFAULT '', at DATETIME NOT NULL, cleared_at DATETIME NULL, cleared_how VARCHAR(255) NULL)");
+$pdo->exec("CREATE TABLE IF NOT EXISTS crawl_run_items (id INT AUTO_INCREMENT PRIMARY KEY, run_id INT, wf VARCHAR(4), task VARCHAR(40), outcome VARCHAR(20), allotted_s INT, seconds INT, fetches INT, searches INT, counts TEXT, why TEXT, at DATETIME)");
+foreach (['last_outcome VARCHAR(20) NULL', 'last_why VARCHAR(255) NULL'] as $c) { try { $pdo->exec('ALTER TABLE crawl_capture_tasks ADD COLUMN ' . $c); } catch (Throwable $x) {} }
+$pdo->exec("INSERT IGNORE INTO crawl_capture_tasks (task, wf, enabled) VALUES ('overture_bulk', 'W1', 1), ('foursquare_bulk', 'W1', 1), ('places', 'W1', 1), ('refresh', 'W2', 1)");
+$paused = fn () => $pdo->query("SELECT CONCAT(kind, ':', ref) FROM system_pauses WHERE cleared_at IS NULL")->fetchAll(PDO::FETCH_COLUMN);
+$open = fn (string $k) => $pdo->query('SELECT * FROM control_alarms WHERE cleared_at IS NULL AND akey = ' . $pdo->quote($k))->fetch(PDO::FETCH_ASSOC) ?: null;
+$runs = 0;
+$report = function (array $items) use ($pdo, &$runs): int {
+    $k = 'r' . (++$runs) . 'x' . bin2hex(random_bytes(4));
+    $pdo->prepare('INSERT INTO crawl_runs (run_key, worker_v, started_at) VALUES (?, ?, NOW())')->execute([$k, '2.16.2']);
+    $id = (int) $pdo->lastInsertId();
+    try { CrawlService::report($pdo, ['run_key' => $k, 'items' => $items]); } catch (Throwable $x) { echo "  (report: " . $x->getMessage() . ")\n"; }
+    Automation::forget();
+    return $id;
+};
+$status = fn (int $id) => (string) $pdo->query("SELECT status FROM crawl_runs WHERE id = $id")->fetchColumn();
+
+// ---- 1. case #51 replayed: foursquare_bulk, then overture_bulk, timed out on /api/crawl/loads.php ----------------------
+$r1 = $report([['task' => 'foursquare_bulk', 'outcome' => 'failed', 'why' => "SiteSlow('site /api/crawl/loads.php: no answer in 120 s')"], ['task' => 'refresh', 'outcome' => 'done']]);
+$r2 = $report([['task' => 'overture_bulk', 'outcome' => 'failed', 'why' => "SiteSlow('site /api/crawl/loads.php: no answer in 120 s')"], ['task' => 'refresh', 'outcome' => 'done']]);
+$t('case #51: our endpoint timing out is no task failure against its source', !$open('task:failed:foursquare_bulk') && !$open('task:failed:overture_bulk'));
+$s = $open('ep:crawl/loads:slow');
+$t('…it\'s recorded against our endpoint, crawl/loads, as slow: a warning', $s && $s['level'] === 'warning' && $s['kind'] === 'slow', $s);
+$t('…and it says nothing is paused', $s && str_contains((string) $s['means'], 'nothing is paused'), $s['means'] ?? '');
+$t('…and nothing is paused: not W1, not the tasks', $paused() === [], $paused());
+// the endpoint answering at its usual speed clears it (the call record's own clear, the same key)
+ControlAlarms::clear($pdo, 'ep:crawl/loads:slow', 'It answered at its usual speed at 08:40 UTC.');
+$t('…cleared by our endpoint answering again (the call record\'s key)', !$open('ep:crawl/loads:slow'));
+
+// ---- 2. a night run whose only trouble is our endpoint isn't "the crawler failed" ------------------------------------
+$pdo->exec('DELETE FROM control_alarms');
+for ($i = 0; $i < 4; $i++) $r = $report([['task' => 'overture_bulk', 'outcome' => 'failed', 'why' => "SiteSlow('site /api/crawl/loads.php: no answer in 120 s')"], ['task' => 'places', 'outcome' => 'idle']]);
+$t('a bulk-only run stopped by our endpoint reads idle, never failed', $status($r) === 'idle', $status($r));
+$t('…so no crawler-down trip, and all gathering keeps going', !$open('run:failed') && $paused() === [], [$open('run:failed'), $paused()]);
+$t('…the run\'s own record still says the task failed and why', (string) $pdo->query("SELECT CONCAT(outcome, ' ', why) FROM crawl_run_items WHERE run_id = $r AND task = 'overture_bulk'")->fetchColumn() === "failed SiteSlow('site /api/crawl/loads.php: no answer in 120 s')");
+
+// ---- 3. a 5xx from our endpoint: its own trip, holding nothing -----------------------------------------------------
+$pdo->exec('DELETE FROM control_alarms');
+for ($i = 0; $i < 4; $i++) $report([['task' => 'overture_bulk', 'outcome' => 'failed', 'why' => "SiteSlow(\"site /api/crawl/loads.php said 500: b'oops'\")"], ['task' => 'refresh', 'outcome' => 'done']]);
+$e = $open('ep:crawl/loads:5xx');
+$t('a 5xx our endpoint gave the worker is the endpoint\'s alarm, never the task\'s', $e && !$open('task:failed:overture_bulk'), $e);
+$t('…its tries run out: a trip', $e && $e['level'] === 'trip', $e['level'] ?? '');
+$t('…which holds nothing: W1 and its tasks carry on', $paused() === [] && Automation::wfOff($pdo, 'W1') === null && Automation::taskOff($pdo, 'overture_bulk') === null, $paused());
+$t('…its words say why nothing is paused', $e && str_contains((string) $e['means'], 'Nothing is paused: the fault is our endpoint\'s'), $e['means'] ?? '');
+// the call record's own path (ControlLedger: the endpoint answered 500, filed on the workflow it serves) holds nothing either
+$pdo->exec('DELETE FROM control_alarms');
+for ($i = 0; $i < 4; $i++) ControlAlarms::raise($pdo, 'ep:crawl/loads:5xx', 'wf:W1', 'trip', 'crash', '/api/crawl/loads answered a server error (500)', 'x', 'y', '500', [], true);
+$t('the call record\'s 5xx on crawl/loads, filed on W1: a trip that pauses nothing (before: all of W1)', ($open('ep:crawl/loads:5xx')['level'] ?? '') === 'trip' && $paused() === [], $paused());
+ControlAlarms::clear($pdo, 'ep:crawl/loads:5xx', 'It answered 200 at 09:00 UTC.');
+$t('…and its next good answer can close it, since nothing stopped the calls', !$open('ep:crawl/loads:5xx'));
+
+// ---- 4. a task's own failure: its trip pauses only that task ---------------------------------------------------------
+$pdo->exec('DELETE FROM control_alarms');
+for ($i = 0; $i < 3; $i++) $report([['task' => 'overture_bulk', 'outcome' => 'failed', 'why' => "RuntimeException('Overture answered rows with no ids')"], ['task' => 'places', 'outcome' => 'done']]);
+$a = $open('task:failed:overture_bulk');
+$t('a task\'s own failure, three times: a trip', $a && $a['level'] === 'trip', $a);
+$t('…it pauses only overture_bulk, never W1', in_array('task:overture_bulk', $paused(), true) && !in_array('wf:W1', $paused(), true) && Automation::wfOff($pdo, 'W1') === null, $paused());
+$t('…W1\'s other tasks still run', Automation::taskOff($pdo, 'places') === null && Automation::taskOff($pdo, 'foursquare_bulk') === null);
+$t('…its words say so', str_contains((string) $a['stopped'], "overture_bulk (W1's other tasks carry on)"), $a['stopped']);
+// ---- 5. the trips already open from before (this morning's two W1 timeouts) get today's rule at the next watch ---------
+$pdo->exec('DELETE FROM control_alarms'); $pdo->exec('DELETE FROM system_pauses'); Automation::forget();
+$old = function (string $key, string $proc, string $reading) use ($pdo): int {
+    $pdo->prepare("INSERT INTO control_alarms (akey, proc, level, kind, title, means, todo, reading, fix, n_times, first_at, last_at, tripped_at, stopped)
+                   VALUES (?, ?, 'trip', 'crash', ?, 'Its work goes back.', '', ?, '', 1, UTC_TIMESTAMP() - INTERVAL 5 HOUR, UTC_TIMESTAMP() - INTERVAL 5 HOUR, UTC_TIMESTAMP() - INTERVAL 4 HOUR, ?)")
+        ->execute([$key, $proc, $key, $reading, json_encode([['pause', 'wf:W1', 'W1 (its tasks wait with it)']])]);
+    $id = (int) $pdo->lastInsertId(); Automation::sysPause($pdo, 'wf', 'W1', $key, $id); return $id;
+};
+$o1 = $old('task:failed:overture_bulk', 'wf:W1', "TimeoutError('The read operation timed out')");
+$o2 = $old('task:failed:foursquare_bulk', 'wf:W1', "TimeoutError('The read operation timed out')");
+$o3 = $old('task:failed:places', 'wf:W1', "RuntimeException('bad answer')");
+$o4 = $old('ep:crawl/loads:5xx', 'wf:W1', '500');
+Automation::forget();
+$t('before: this morning\'s trips hold all of W1', Automation::sysOff($pdo, 'wf', 'W1') !== null);
+$did = ControlAlarms::settleNarrow($pdo); Automation::forget();
+$t('the two bulk loads\' read timeouts are re-filed as our endpoint slow and closed (IR-0001)', !$open('task:failed:overture_bulk') && !$open('task:failed:foursquare_bulk'), $did);
+$cl = (string) $pdo->query("SELECT cleared_how FROM control_alarms WHERE id = $o1")->fetchColumn();
+$t('…saying so', str_contains($cl, 'our load endpoint (/api/crawl/loads) didn\'t answer in time'), $cl);
+$t('W1 is no longer held whole', Automation::sysOff($pdo, 'wf', 'W1') === null, $paused());
+$t('a task\'s own old trip now holds only that task', $paused() === ['task:places'], $paused());
+$t('…its record says what it holds now', str_contains((string) ($open('task:failed:places')['stopped'] ?? ''), 'task:places'));
+$ep4 = $open('ep:crawl/loads:5xx');
+$t('our endpoint\'s old trip holds nothing now', $ep4 !== null && $ep4['stopped'] === null, $ep4['stopped'] ?? 'no alarm');
+$t('…and the narrowing is in the logbook', (int) $pdo->query("SELECT COUNT(*) FROM control_log WHERE what LIKE 'Narrowed:%'")->fetchColumn() >= 2);
+$t('run again: nothing more to do', ControlAlarms::settleNarrow($pdo) === []);
+$t('the bulk loads run tonight: nothing pauses overture_bulk or foursquare_bulk', Automation::taskOff($pdo, 'overture_bulk') === null && Automation::taskOff($pdo, 'foursquare_bulk') === null);
+// ---- and a paused task's trip can close: lifted (a person's lift places the same resume), its next run clears it ------
+Automation::sysResume($pdo, (int) $open('task:failed:places')['id'], 'Lifted by Jason'); Automation::forget();
+$report([['task' => 'places', 'outcome' => 'done']]);
+$t('a lifted task\'s next good run closes its trip', !$open('task:failed:places') && $paused() === []);
+
+// ---- 6. Keep the hour, untouched ---------------------------------------------------------------------------------------
+$pdo->exec('DELETE FROM control_alarms');
+$report([['task' => 'overture_bulk', 'outcome' => 'failed', 'why' => "RuntimeException('x')"], ['task' => 'places', 'outcome' => 'done']]);
+$w = $open('task:failed:overture_bulk');
+$t('Keep the hour as set: a first failure is a warning with its tries until the hour', $w && $w['level'] === 'warning' && str_contains((string) $w['means'], ' tries, until '), $w['means'] ?? '');
+echo "\n$pass passed, $fail failed\n"; exit($fail ? 1 : 0);
