+     * the minute ("open now") gets no number (B2); one that finds nothing, or can't be run, shows no number rather than a
+     * wrong one. The phrases come from the device. A count is kept an hour by phrase and place (its key a hash of both),
+     * never with who asked; counts past their hour are cleared (sweepMine).
+     * @param list<string> $phrases at most 12, as kept by js/search-panel.js
+     * @return list<array{q: string, count: ?int}>
+     */
+    public static function mine(PDO $pdo, array $ctx, array $phrases): array
+    {
+        self::sweepMine($pdo);
+        $out = []; $seen = [];
+        foreach (array_slice($phrases, 0, 12) as $q) {
+            if (!is_string($q)) continue;
+            $q = mb_substr(trim(preg_replace('/\s+/u', ' ', $q)), 0, 80);
+            $low = mb_strtolower($q);
+            if (mb_strlen($q) < 2 || isset($seen[$low])) continue;
+            $seen[$low] = 1;
+            $out[] = ['q' => $q, 'count' => self::countMine($pdo, $ctx, $q)];
+        }
+        return $out;
+    }
+
+    /** Clears the own-phrase counts past their hour (at most once every 10 minutes), so they don't pile up. */
+    public static function sweepMine(PDO $pdo): void
+    {
+        try {
+            $m = SearchIndex::state($pdo, 'pmsweep');
+            if ($m !== '' && (int) $m > time() - 600) return;
+            SearchIndex::setState($pdo, 'pmsweep', (string) time());
+            $old = [];
+            foreach ($pdo->query("SELECT k, v FROM search_index_state WHERE k LIKE 'pm:%' LIMIT 2000")->fetchAll(PDO::FETCH_ASSOC) as $r) {
+                $j = json_decode((string) $r['v'], true);
+                if (!is_array($j) || (int) ($j['t'] ?? 0) < time() - 3600) $old[] = (string) $r['k'];
+            }
+            foreach (array_chunk($old, 200) as $ch) $pdo->prepare('DELETE FROM search_index_state WHERE k IN (' . implode(',', array_fill(0, count($ch), '?')) . ')')->execute($ch);
+        } catch (Throwable $e) { error_log('quick search sweep: ' . $e->getMessage()); }
+    }
+
+    private static function countMine(PDO $pdo, array $ctx, string $q): ?int
+    {
+        try {
+            $u = UniversalSearch::understand($pdo, $q, $ctx, []);
+            foreach ($u['chips'] as $c) if (($c['type'] ?? '') === 'when' && ($c['value'] ?? '') === 'now') return null;   // by the minute (B2)
+            $where = [$ctx['level'] ?? '', $ctx['slug'] ?? '', $ctx['town'] ?? '', $ctx['city'] ?? '', $ctx['state'] ?? '', $ctx['zip'] ?? '',
+                isset($ctx['lat']) ? round((float) $ctx['lat'], 2) : '', isset($ctx['lon']) ? round((float) $ctx['lon'], 2) : '', $ctx['reach'] ?? '', $ctx['track'] ?? ''];
+            $key = 'pm:' . substr(md5(json_encode([$where, mb_strtolower($q)])), 0, 20);
+            $c = SearchIndex::state($pdo, $key);
+            if ($c !== '' && ($j = json_decode($c, true)) && ($j['t'] ?? 0) > time() - 3600) return $j['n'] ?? null;
+            $r = UniversalSearch::search($pdo, $q, $ctx + ['no_side' => 1]);
+            $n = (int) ($r['results']['total'] ?? 0);   // what its Results tab says
+            $n = $n > 0 ? $n : null;
+            try { SearchIndex::setState($pdo, $key, json_encode(['t' => time(), 'n' => $n])); } catch (Throwable) {}
+            return $n;
+        } catch (Throwable $e) { error_log('quick search count: ' . $e->getMessage()); return null; }
+    }
