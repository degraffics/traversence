+    /** A staff login's work email from its hidden record's address (<staff id>@staff.traversence.invalid), as Notify finds it; '' when none. */
+    private static function staffWorkEmail(string $hidden): string
+    {
+        try {
+            require_once __DIR__ . '/Database.php';
+            $pdo = Database::connection();
+            $st = $pdo->prepare('SELECT s.email FROM ' . Database::t('staff_accounts') . " s JOIN users u ON u.id = s.user_id WHERE u.email = ? AND s.status = 'active' LIMIT 1");
+            $st->execute([trim($hidden)]);
+            $e = trim((string) ($st->fetchColumn() ?: ''));
+            return filter_var($e, FILTER_VALIDATE_EMAIL) && !str_ends_with(strtolower($e), '.invalid') ? $e : '';
+        } catch (Throwable $x) { return ''; }
+    }
