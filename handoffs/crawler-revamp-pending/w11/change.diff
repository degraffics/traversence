+    /** May a page's steps be drafted from (the source register: not cite-only, evidence or a pointer, not set to Ignore)? */
+    private static function mayUse(PDO $pdo, string $url): bool
+    {
+        try {
+            require_once __DIR__ . '/crawler/Sources.php';
+            $host = Sources::host($url);
+            if (!Sources::mayStore($pdo, $host)) return false;
+            $st = $pdo->prepare('SELECT status FROM ' . Database::t('reference_sources') . ' WHERE host = ?'); $st->execute([$host]);
+            return $st->fetchColumn() !== 'ignore';
+        } catch (Throwable $e) { return true; }   // before the register: official pages, as before
+    }
+
+    /**
+     * A step that still reads as its source wrote it, from a source whose licence isn't open (review C14: steps went out
+     * word for word from .edu and state pages): the message naming the first, or ''. Open licences (public domain, CC0,
+     * CC BY, CC BY-SA) may be quoted, with the source shown as now.
+     */
+    public static function copied(PDO $pdo, array $steps, array $sources): string
+    {
+        $words = fn (string $t) => array_values(array_filter(explode(' ', (string) preg_replace('/[^a-z0-9 ]+/', ' ', mb_strtolower($t)))));
+        foreach ($steps as $i => $st) {
+            $src = $sources[(int) $st['src'] - 1] ?? null;
+            if (!$src || empty($src['said'])) continue;   // drafted before its words were kept: the person's word stands
+            $licence = 'unknown';
+            try { require_once __DIR__ . '/crawler/Sources.php'; $licence = (string) (Sources::rules($pdo, (string) $src['host'])['licence'] ?? 'unknown'); } catch (Throwable $e) {}
+            if (in_array($licence, ['public_domain', 'cc0', 'cc_by', 'cc_by_sa'], true)) continue;
+            $a = $words((string) $st['text']);
+            if (count($a) < 4) continue;   // "Rake the leaves." can only be said one way
+            foreach ((array) $src['said'] as $said) {
+                $b = $words((string) $said);
+                $same = count(array_intersect(array_unique($a), array_unique($b))) / max(1, count(array_unique(array_merge($a, $b))));
+                if ($same >= 0.8) return 'Step ' . ($i + 1) . ' reads as ' . $src['host'] . ' wrote it, and its terms don\'t let us copy it: put it in our own words.';
+            }
+        }
+        return '';
+    }
