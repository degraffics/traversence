--- a/website/js/admin-releases.js
+++ b/website/js/admin-releases.js
@@ -82,3 +82,25 @@
     go();
   });
 })();
+
+// each release folds to one line (Jason, 2026-11-17): open while it needs him, as the page draws it; what he opens or closes
+// is remembered per release until its state changes (then the page's default again); a link to #rel-N opens that one and
+// goes to it
+(function () {
+  var folds = document.querySelectorAll('details[data-rel-fold]');
+  if (!folds.length) return;
+  function key(d) { return 'tv-rel-fold:' + d.getAttribute('data-rel-fold'); }
+  Array.prototype.forEach.call(folds, function (d) {
+    var st = d.getAttribute('data-rel-state') || '';
+    try { var v = localStorage.getItem(key(d)); if (v) { var p = v.split(':'); if (p[0] === st) d.open = p[1] === '1'; else localStorage.removeItem(key(d)); } } catch (x) {}
+    d.addEventListener('toggle', function () { if (d._tvHash) { d._tvHash = false; return; } try { localStorage.setItem(key(d), st + ':' + (d.open ? '1' : '0')); } catch (x) {} });
+  });
+  function toHash() {
+    var m = /^#rel-(\d+)$/.exec(location.hash || ''); if (!m) return;
+    var d = document.getElementById('rel-' + m[1]); if (!d || d.tagName !== 'DETAILS') return;
+    if (!d.open) { d._tvHash = true; d.open = true; }   // opened by a link: not remembered as his choice
+    setTimeout(function () { d.scrollIntoView({ block: 'start' }); }, 0);
+  }
+  toHash();
+  window.addEventListener('hashchange', toHash);
+})();
