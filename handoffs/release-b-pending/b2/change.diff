+-- Release B (decisions/0164 R17, §7.1; 0163 §8 stage 10): a hub's stage on its readiness meter and its opening budget,
+-- and W14's staged authority sources (Arizona's and New Mexico's from the rural test's Run 2, staged by hand, switched
+-- off). Safe to run twice: tables if missing, rows only if missing.
+CREATE TABLE IF NOT EXISTS hub_stages (
+  hub_id INT UNSIGNED NOT NULL,
+  stage VARCHAR(10) NOT NULL DEFAULT 'open',
+  state CHAR(2) DEFAULT NULL,
+  opening_budget_usd DECIMAL(10,2) DEFAULT NULL,
+  set_by INT UNSIGNED DEFAULT NULL,
+  set_at DATETIME DEFAULT NULL,
+  PRIMARY KEY (hub_id)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+CREATE TABLE IF NOT EXISTS authority_sources (
+  id INT UNSIGNED NOT NULL AUTO_INCREMENT,
+  state CHAR(2) NOT NULL,
+  kind VARCHAR(20) NOT NULL,
+  name VARCHAR(160) NOT NULL,
+  url VARCHAR(500) NOT NULL,
+  host VARCHAR(160) NOT NULL,
+  service VARCHAR(20) DEFAULT NULL,
+  real_use VARCHAR(10) NOT NULL DEFAULT 'lookup',
+  proves VARCHAR(200) DEFAULT NULL,
+  terms_url VARCHAR(500) DEFAULT NULL,
+  terms_read_at DATETIME DEFAULT NULL,
+  terms_by INT UNSIGNED DEFAULT NULL,
+  reader_ok_at DATETIME DEFAULT NULL,
+  provenance VARCHAR(500) DEFAULT NULL,
+  status VARCHAR(10) NOT NULL DEFAULT 'staged',
+  enabled TINYINT NOT NULL DEFAULT 0,
+  on_by INT UNSIGNED DEFAULT NULL,
+  on_at DATETIME DEFAULT NULL,
+  note VARCHAR(500) DEFAULT NULL,
+  added_at DATETIME NOT NULL,
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_state_url (state, url(190))
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
