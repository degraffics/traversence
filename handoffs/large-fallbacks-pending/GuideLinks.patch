+    /**
+     * Find it's web step (the crawler's find_name request: one web search, Tavily then Brave, then its own website): 'wait'
+     * while the request is out (a day at most), 'found' when the crawler found and staged it, else '' (Claude next).
+     */
+    private static function webStep(PDO $pdo, array $j, ?array $p, string $tried): string
+    {
+        if ($tried === '' || !$p) return '';
+        $r = json_decode((string) ($j['result'] ?? ''), true) ?: [];
+        if (($r['web'] ?? '') === 'done') return '';
+        try { require_once __DIR__ . '/crawler/CrawlService.php'; if (!CrawlService::ready($pdo)) return ''; } catch (Throwable $x) { return ''; }
+        $req = (int) ($r['web'] ?? 0);
+        if ($req <= 0) {
+            [$town, $state] = array_pad(array_map('trim', explode(',', (string) ($j['near'] ?? ''), 2)), 2, '');
+            if ($state === '') $state = (string) ($p['state'] ?? '');
+            try {
+                $req = CrawlService::request($pdo, 'W1', 'find_name', 'gf:' . (int) $j['id'], ['name' => (string) $j['name'], 'city' => $town !== '' ? $town : (string) ($p['name'] ?? ''), 'state' => $state, 'place' => (string) $j['place_key'], 'find' => (int) $j['id']], 6);
+            } catch (Throwable $x) { error_log('guide find web step: ' . $x->getMessage()); return ''; }
+            $pdo->prepare('UPDATE guide_finds SET result = ? WHERE id = ?')->execute([json_encode(['crawler' => 'none', 'web' => $req, 'web_at' => date('c')]), (int) $j['id']]);
+            return 'wait';
+        }
+        $st = $pdo->prepare('SELECT status, result FROM crawl_requests WHERE id = ?'); $st->execute([$req]);
+        $q = $st->fetch(PDO::FETCH_ASSOC);
+        $res = $q ? (json_decode((string) $q['result'], true) ?: []) : [];
+        if ($q && in_array($q['status'], ['queued', 'leased'], true) && strtotime((string) ($r['web_at'] ?? 'now')) > time() - 86400) return 'wait';
+        $pdo->prepare('UPDATE guide_finds SET result = ? WHERE id = ?')->execute([json_encode(['crawler' => 'none', 'web' => 'done', 'web_req' => $req]), (int) $j['id']]);
+        if ($q && $q['status'] === 'done' && !empty($res['found']) && ((int) ($res['staged'] ?? 0) + (int) ($res['published'] ?? 0) + (int) ($res['known'] ?? 0)) > 0) {
+            // staged by the crawler's request (CrawlService::deliver): the listing checks decide; the name links when it's listed
+            $pdo->prepare("UPDATE guide_finds SET status = 'found', result = ?, done_at = NOW() WHERE id = ?")->execute([json_encode(['by' => 'our crawler (web search)', 'site' => (string) ($res['site'] ?? ''), 'request' => $req], JSON_UNESCAPED_SLASHES), (int) $j['id']]);
+            $pdo->prepare("UPDATE content_tags SET status = 'review', note = ?, updated_at = NOW() WHERE find_id = ? AND status IN ('finding','unconfirmed')")->execute(['Found by our crawler\'s web search: going through the listing checks; it links once listed.', (int) $j['id']]);
+            return 'found';
+        }
+        return '';
+    }
