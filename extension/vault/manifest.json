{
  "manifest_version": 3,
  "name": "Traversence Vault",
  "version": "0.1.4",
  "description": "Fills your Traversence Vault logins on their own sites, and offers to save new ones. For Traversence staff (stage 1).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["https://traversence.com/*", "https://www.traversence.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }],
  "externally_connectable": { "matches": ["https://traversence.com/*", "https://www.traversence.com/*"] },
  "action": { "default_title": "Traversence Vault", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
